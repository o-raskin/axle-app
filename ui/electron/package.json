{
  "name": "@lego-technic-gamepad-bridge/electron-ui",
  "version": "0.1.0",
  "description": "Axle, an independent desktop companion for gamepad-controlled Technic vehicles.",
  "homepage": "https://github.com/o-raskin/lego-technic-gamepad-bridge",
  "private": true,
  "main": "dist/main/index.js",
  "author": "LEGO Technic Gamepad Bridge contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "oxlint --deny-warnings src scripts tests models/tumbler/source/axle-details.mjs electron.vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.cjs",
    "test:coverage": "c8 node --enable-source-maps scripts/test.cjs",
    "test:ui": "node scripts/smoke-test.cjs",
    "test:package": "node scripts/verify-package.cjs",
    "model:build": "node scripts/build-tumbler-model.mjs",
    "model:extract": "node scripts/manage-tumbler-source.mjs extract",
    "model:pack": "node scripts/manage-tumbler-source.mjs pack",
    "model:preview": "node scripts/preview-tumbler-model.cjs",
    "prebuild": "node scripts/generate-software-notices.cjs",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:mac:signed": "npm run build && electron-builder --mac --config.mac.identity=\"$CSC_NAME\" --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:steamdeck": "npm run build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "c8": "12.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "meshoptimizer": "1.3.0",
    "oxlint": "1.86.0",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "o-raskin",
      "repo": "axle-app",
      "releaseType": "release"
    },
    "appId": "dev.lego-technic-gamepad-bridge.ui",
    "productName": "Axle",
    "icon": "resources/icon.png",
    "asar": true,
    "toolsets": {
      "appimage": "1.0.3"
    },
    "beforePack": "scripts/bundle-bridge.cjs",
    "extraResources": [
      {
        "from": "resources/bridge",
        "to": "bridge"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "models/tumbler/LICENSE.md",
        "to": "licenses/tumbler/LICENSE.md"
      },
      {
        "from": "models/tumbler/generated/THIRD-PARTY-NOTICES.md",
        "to": "licenses/tumbler/generated/THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "models/tumbler/RIGHTS.md",
        "to": "licenses/tumbler/RIGHTS.md"
      },
      {
        "from": "models/tumbler/source/provenance.json",
        "to": "licenses/tumbler/source/provenance.json"
      },
      {
        "from": "models/tumbler/source/LICENSE-EVIDENCE.md",
        "to": "licenses/tumbler/source/LICENSE-EVIDENCE.md"
      },
      {
        "from": "resources/THIRD-PARTY-SOFTWARE-NOTICES.txt",
        "to": "licenses/THIRD-PARTY-SOFTWARE-NOTICES.txt"
      },
      {
        "from": "environment/LICENSE.md",
        "to": "licenses/environment/LICENSE.md"
      },
      {
        "from": "environment/README.md",
        "to": "licenses/environment/README.md"
      },
      {
        "from": "environment/CC0-1.0.txt",
        "to": "licenses/environment/CC0-1.0.txt"
      },
      {
        "from": "environment/provenance.json",
        "to": "licenses/environment/provenance.json"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/chromium.html"
      }
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "mac": {
      "identity": "-",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Axle uses Bluetooth to connect to and control your Technic Move Hub."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "backgroundColor": "#f4f3ef",
      "window": {
        "width": 540,
        "height": 440
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 130,
          "y": 150,
          "type": "file"
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 320,
          "type": "file",
          "path": "resources/Open Axle on macOS.txt"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "executableName": "axle",
      "maintainer": "LEGO Technic Gamepad Bridge contributors",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "packageName": "axle"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
